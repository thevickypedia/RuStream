authorization={"admin":"password123"}
media_source=/data/media
media_host=0.0.0.0
media_port=8000
base_url=/
debug=false
utc_logging=true
session_duration=3600
file_formats=["mp4","mov","jpg","jpeg"]
workers=4
max_connections=3
max_payload_size=100 MB
secure_session=false
# Enable on-demand ffmpeg conversions (requires ffmpeg in the image)
ffmpeg_enabled=false
# UID/GID of the host user that owns the ./media folder (used by docker compose)
UID=1000
GID=1000
